{
  "name": "munim-xr-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-xr.git"
  },
  "scripts": {
    "build": "npm --workspace munim-xr run build",
    "codegen": "npm --workspace munim-xr run codegen",
    "lint": "npm --workspace munim-xr run lint-ci",
    "typecheck": "npm --workspace munim-xr run typecheck",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "check": "npm run codegen && npm run lint && npm run typecheck && npm run test && npm run build && npm run typecheck:example && npm run pack:dry-run",
    "pack:dry-run": "npm --workspace munim-xr pack --dry-run",
    "example:start": "npm --workspace example run start",
    "example:ios": "npm --workspace example run ios",
    "example:android": "npm --workspace example run android",
    "test": "npm --workspace munim-xr run test",
    "release": "semantic-release",
    "release:local": "node scripts/release-local.mjs"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    }
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^26.0.1"
  }
}
