{
  "name": "munim-xr-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm --workspace munim-xr run build",
    "codegen": "npm --workspace munim-xr run codegen",
    "lint": "npm --workspace munim-xr run lint-ci",
    "typecheck": "npm --workspace munim-xr run typecheck",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "check": "npm run codegen && npm run lint && npm run typecheck && npm run typecheck:example && npm run build && npm run pack:dry-run",
    "pack:dry-run": "npm --workspace munim-xr pack --dry-run",
    "example:start": "npm --workspace example run start",
    "example:ios": "npm --workspace example run ios",
    "example:android": "npm --workspace example run android"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
