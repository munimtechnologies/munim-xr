{
  "name": "munim-xr",
  "version": "0.5.0",
  "description": "Cross-platform XR sessions and native AR views for Expo and React Native, powered by Nitro Modules",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "cpp",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "lint": "eslint . --fix",
    "lint-ci": "eslint . --max-warnings 0",
    "build": "npm run typecheck && tsc",
    "prepack": "npm run build",
    "typescript": "tsc",
    "codegen": "nitrogen --logLevel=\"debug\" && node scripts/patch-nitro-optionals.js && node scripts/patch-nitro-double-vectors.js",
    "specs": "npm run codegen",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "expo",
    "xr",
    "ar",
    "mixed-reality",
    "arkit",
    "arcore",
    "augmented-reality",
    "spatial-computing",
    "world-tracking",
    "plane-detection",
    "computer-vision",
    "native-module",
    "new-architecture",
    "ios",
    "android",
    "typescript",
    "nitro",
    "nitro-modules",
    "munim-technologies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-xr.git"
  },
  "author": "sheehanmunim <support@munimtech.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/munimtechnologies/munim-xr/issues"
  },
  "homepage": "https://github.com/munimtechnologies/munim-xr#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-xr",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "0.37.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78",
    "react-native-nitro-modules": ">=0.37.2 <1"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ]
  }
}
